[rf]
freq_offset = 0
tx_gain = 50
rx_gain = 40
srate = 11.52e6
nof_antennas = 1

device_name = zmq
device_args = tx_port=tcp://0.0.0.0:{{ (current_ue.zmq_port | default(2000)) | int + 1 }},rx_port=tcp://{{ current_ue.target_du_ip }}:{{ current_ue.zmq_port | default(2000) }},base_srate=11.52e6

[rat.eutra]
dl_earfcn = 2850
nof_carriers = 0

[rat.nr]
bands = 3
nof_carriers = 1
max_nof_prb = 52
nof_prb = 52

[pcap]
enable = none
mac_filename = /tmp/ue_mac_{{ ue_id }}.pcap
mac_nr_filename = /tmp/ue_mac_nr_{{ ue_id }}.pcap
nas_filename = /tmp/ue_nas_{{ ue_id }}.pcap

[log]
all_level = info
phy_lib_level = none
all_hex_limit = 32
filename = /tmp/ue_{{ ue_id }}.log
file_max_size = -1

[usim]
mode = soft
algo = milenage
opc  = 981d464c7c52eb6e5036234984ad0bcf
k    = 5122250214c33e723a5dd523fc145fc0
imsi = {{ current_ue.imsi }}
imei = 356938035643803

[rrc]
release = 15
ue_category = 4

[nas]
apn = internet
apn_protocol = ipv4

[gw]
netns = ue1
ip_devname = tun_srsue
ip_netmask = 255.255.255.0

[gui]
enable = false

[phy]
nof_phy_threads = {{ (ocudu_orch.ran_tuning if ocudu_orch is defined and ocudu_orch.ran_tuning is defined else (ocudu.ran_tuning if ocudu is defined and ocudu.ran_tuning is defined else {})).ue_phy_threads | default(1) }}

