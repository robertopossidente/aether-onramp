[Unit]
Description=OCUDU CU/DU Prometheus exporter
After=docker.service
Wants=docker.service

[Service]
ExecStart=/usr/bin/python3 {{ ocudu_exporter_dir }}/ocudu_exporter.py --listen {{ ocudu_exporter_bind }} --port {{ ocudu_exporter_port }} --cu-container {{ ocudu_exporter_cu_container }} --du-container {{ ocudu_exporter_du_container }} --du-ws-host 127.0.0.1 --du-ws-port {{ ocudu_exporter_du_ws_port }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
