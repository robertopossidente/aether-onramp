apiVersion: v1
kind: Service
metadata:
  name: ocudu-exporter
  namespace: aether-5gc
  labels:
    app: ocudu-exporter
spec:
  clusterIP: None
  ports:
    - name: metrics
      port: {{ split_exporter_port }}
      targetPort: {{ split_exporter_port }}
---
apiVersion: v1
kind: Endpoints
metadata:
  name: ocudu-exporter
  namespace: aether-5gc
  labels:
    app: ocudu-exporter
subsets:
  - addresses:
      - ip: {{ split_exporter_host }}
    ports:
      - name: metrics
        port: {{ split_exporter_port }}
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: ocudu-exporter
  namespace: aether-5gc
spec:
  endpoints:
    - path: /metrics
      port: metrics
      interval: 5s
      scrapeTimeout: 4s
  namespaceSelector:
    matchNames:
      - aether-5gc
  selector:
    matchLabels:
      app: ocudu-exporter
