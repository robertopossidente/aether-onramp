        },
        "definition": "label_values(up{job=~\"ocudu-exporter-.*\"}, gnb)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "node2|node3",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
